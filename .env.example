# Copy to .env and fill in your key:  cp .env.example .env
# .env is gitignored. Never commit a real key.

# ---- Providers ----
# Generation and embedding are routed independently: one provider can answer
# while a different one embeds.
#
# The defaults are LOCAL OLLAMA, which needs no API key. The two keys below are
# only needed if you switch to a hosted provider; they are left here so that is a
# one-line change rather than a code change.
#
# Prerequisites for the local default — or just run:
#   ./scripts/ollama-host-setup.sh
# which pulls the three models, sets OLLAMA_HOST=0.0.0.0 in a systemd drop-in so a
# container can reach the daemon, and restarts Ollama. Needs sudo once.
#
#   ollama pull nomic-embed-text                            # 274MB, 768 dims
#   ollama pull mashriram/sarvam-1                          # ~2.5GB, generation
#   ollama pull MedAIBase/Tencent-HY-MT1.5:1.8b-q4_K_M      # ~1.9GB, translation
#   OLLAMA_CONTEXT_LENGTH=8192 OLLAMA_KEEP_ALIVE=-1 ollama serve
#
# Note the namespace: the registry name is "mashriram/sarvam-1". Plain "sarvam-1"
# is a different, untuned model and will not start.
GEMINI_API_KEY=
OPEN_ROUTER_API_KEY=

# Generation: local Ollama, no cloud fallback.
# The reason is quota, not cost. Both hosted free tiers cap by REQUEST COUNT per
# day and this project cannot risk exhausting either mid-demo: Gemini's free tier
# allows ~20 generateContent requests/day, OpenRouter's :free allows 50/day.
# Local inference has no quota at all. The trade is latency — sarvam-1 is 2B on
# CPU with no GPU, so answers take tens of seconds.
GEN_PROVIDER=ollama
GEN_FALLBACK_PROVIDER=
GEN_FALLBACK=false
# 2B, pre-trained on 10 Indic languages including Punjabi and Telugu, Apache-2.0.
# Chosen over llama3.2:3b because Llama 3.2 officially supports only 8 languages
# (no Punjabi, no Telugu) and scores 26-33 on the MILU Indic benchmark against a
# random baseline of 25.
GEN_MODEL=mashriram/sarvam-1
GEN_TEMPERATURE=0.1
# 700, not 1200: the window is 8,192 and a grounded prompt is already ~6,600.
GEN_MAX_TOKENS=700

# Embeddings: local Ollama, nomic-embed-text.
# 768 is this model's NATIVE width, so the pgvector column stays at 768 and no
# dimension truncation is involved. Replaces OpenRouter text-embedding-3-small,
# whose free tier allowed only 50 requests/day against a 3,445-chunk corpus.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# A property of the model, not a free choice. pgvector HNSW/IVFFlat also cannot
# index vectors wider than 2000 dims, which rules out Gemini's 3072 default.
# If you switch models, set this to the model's native width and re-ingest:
#   nomic-embed-text                 768, fixed and native (Matryoshka-capable,
#                                    but Ollama's `dimensions` must be LOWER
#                                    than native, so do not send it)
#   openai/text-embedding-3-small   1536, truncates on request
#   lfm-2.5-embedding-350m:free      1024, fixed, and caps input at 512 tokens
#   gemini-embedding-001             768 default, 128-3072 supported
EMBED_DIMS=768
EMBED_BATCH_SIZE=25
# nomic-embed-text has no `title` field, so the standard's designation is
# prepended behind a `search_document:` task prefix; queries get `search_query:`.
# That asymmetry is the one the model was trained on.
EMBED_PREFIX_TITLE=true

# ---- Local Ollama daemon ----
# Ollama runs on the HOST, not in a container, and the weights are 4.6 GB — in a
# Compose volume they would be lost to a stray `docker compose down -v` and
# re-downloaded on every new machine. Set the binding and pull the three models
# with:  ./scripts/ollama-host-setup.sh
#
# This value is what the APP uses. In Docker it is overridden to
# http://host.docker.internal:11434, because a container cannot reach the host's
# loopback interface. Ollama must therefore be listening on 0.0.0.0, not
# 127.0.0.1, or the app cannot connect however healthy Ollama looks from your
# shell. That is what the setup script's drop-in does, and what
# `--scripts/ollama-host-setup.sh --check` verifies from inside a container.
#
# Note that this exposes Ollama to your whole network; it has no authentication.
# Use `./scripts/ollama-host-setup.sh --revert` on an untrusted network.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# MUST be at least the prompt size. Ollama defaults to 4,096 on a machine with no
# GPU and, for registry models, does not reject an oversized prompt — it silently
# trims the evidence and still returns HTTP 200. A grounded prompt here is
# ~5,400-6,600 tokens, so the default would answer from a third of the passages
# with nothing reporting a problem. providers/ollama.js also sends num_ctx on
# every request, because a Modelfile can override the server-wide default.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_TIMEOUT_MS=300000
# Token budget for retrieved passages, derived in config.js as
# context window - output reserve. Set only to override that.
# CONTEXT_TOKEN_BUDGET=6980

# ---- Vector store (local Docker pgvector) ----
# Start it with:  docker compose up -d
DATABASE_URL=postgres://bis:bis@127.0.0.1:5433/bis_rag

# ---- Chunking (ingest time) ----
CHUNK_CHARS=1200
CHUNK_OVERLAP=200
# Smallest chunk worth sealing at a clause boundary for. A technical standard is
# mostly short numbered requirements, and sealing on all of them produced 7,153
# fragments averaging 211 characters from a 929-page document. Capped at 2% of the
# document so it stays inert on small inputs, where per-clause citations are what
# you want.
CHUNK_MIN_SEAL_CHARS=600

# ---- Retrieval (query time) ----
TOP_K=5
# Cosine cut-off, applied in SQL so weak context never reaches the model.
#
# MEASURED, NEVER GUESSED. Run `npm run calibrate`; it prints the in-corpus and
# out-of-corpus distributions and only suggests a value if they do not overlap.
# Thresholds are not transferable between models — gemini-embedding-001 put
# greetings as high as 0.6056 while lfm-2.5-embedding-350m put the same strings
# as low as 0.04 — so re-measure after changing provider, model, width, or corpus.
# To explore without committing to a value:
#   curl "localhost:3000/api/search?q=your+question&k=8&threshold=0"
#
# This is the TOP of a three-band scale, not a single cutoff, because the two
# distributions genuinely overlap on this corpus: in-corpus questions measure
# 0.677-0.826 and out-of-corpus questions reach 0.708, so no single number
# separates them. Retrieval therefore fetches down to BRIDGE_FLOOR and decides
# afterwards:
#
#   >= 0.67  answer  the clause is handed to the model
#   >= 0.60  soft    the model is asked to answer or decline; on decline the
#                   reply falls back to the near-miss bridge
#   >= 0.45  bridge  "no X, but the closest thing is Y, clause Z"
#   <  0.45  miss    echo the query and offer topics parsed from the corpus
#
# 0.67 rather than a rounder 0.65 because "fly ash" measures 0.668: a true
# question about a material the document actually covers. Anything above the
# in-corpus minimum will refuse real questions, anything below admits noise.
SIMILARITY_THRESHOLD=0.67
# Where a genuine attempt starts: above the out-of-corpus median (0.565), below
# the in-corpus minimum (0.677), so most real questions reach the model.
SOFT_THRESHOLD=0.60
# Below this there is nothing worth bridging to, so a reply stops naming candidate
# clauses and only suggests topics. Set just under the measured out-of-corpus
# floor of 0.466 so a borderline miss still gets a concrete nearest clause.
BRIDGE_FLOOR=0.45
# How many corpus-derived topics a dead-end reply offers.
SUGGESTION_COUNT=6

# ---- Hybrid retrieval ----
# The vector search and a Postgres full-text search run together and fuse by
# reciprocal rank. RRF is used rather than a weighted score sum because cosine
# similarity and ts_rank are not on a comparable scale, so any numeric blend has
# to be re-tuned whenever either side changes; RRF only depends on rank order.
HYBRID_SEARCH=true
# RRF damping constant. 60 is the value from the original Cormack et al. paper and
# is not corpus-specific; lower values let the top rank dominate.
RRF_K=60
# Candidates pulled from the keyword arm before fusion. Sits well above TOP_K
# because fusion is rank-based: a keyword hit ranked 20th can still reach the
# final 5 if the vector arm missed it entirely, which is the whole point.
KEYWORD_TOP_K=20

# ---- Corpus ----
PDF_DIR=./data/pdfs
# Comma-separated filename substrings to leave out of ingestion (case-insensitive).
# Files stay in the folder; this only skips them, so a document can be switched
# back on by editing this line.
# listofproducts is a scanned image PDF with no text layer, so it yields nothing
# until it is OCR'd. The BIS_CA_* files are Hindi fee-schedule tables rather than
# product standards, and once contributed 91% of the corpus as garbled 85-character
# fragments.
PDF_EXCLUDE=listofproducts
