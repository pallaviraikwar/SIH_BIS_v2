# Copy to .env and fill in your key:  cp .env.example .env
# .env is gitignored. Never commit a real key.

# ---- Google Gemini ----
GEMINI_API_KEY=

# Text-only embedding model. Keep EMBED_DIMS at 768: pgvector HNSW/IVFFlat
# cannot index vectors above 2000 dims, and Gemini's default 3072 exceeds that.
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# Generation model. gemini-3.6-flash = stable/GA, cheap. gemini-3.8-flash = newest GA.
GEN_MODEL=gemini-3.6-flash

# ---- Vector store (local Docker pgvector) ----
# Start it with:  docker compose up -d
DATABASE_URL=postgres://bis:bis@127.0.0.1:5433/bis_rag

# ---- Chunking (ingest time) ----
CHUNK_CHARS=1200
CHUNK_OVERLAP=200

# ---- Retrieval (query time) ----
TOP_K=5
# Cosine cut-off, applied in SQL so weak context never reaches the model.
#
# The threshold is corpus-specific, not universal. These numbers were measured
# against the 6 regulatory documents in this repo (536 chunks); Gemini cosine
# scores sit in a narrow band, so a naive low threshold matches everything.
#
#   in-corpus  top-1 similarity: 0.625 - 0.764
#   off-topic   top-1 similarity: 0.466 - 0.563
#   => usable gap: (0.563, 0.625]
#
# Start at 0.60, then re-measure your own corpus before trusting any answer:
#   curl "localhost:3000/api/search?q=your+question&k=8&threshold=0"
# Do this after changing EMBED_MODEL/EMBED_DIMS, and after adding documents —
# stored vectors are only comparable within one model and width.
SIMILARITY_THRESHOLD=0.60

# ---- Corpus ----
PDF_DIR=./data/pdfs
# Comma-separated filename substrings to leave out of ingestion (case-insensitive).
# Files stay in the folder; this only skips them, so you can switch a document
# back on by editing this line. The two BIS_CA_* files are excluded because they
# are Hindi fee-schedule tables, not product standards: 91% of the corpus's
# chunks came from them as garbled 85-character fragments.
PDF_EXCLUDE=BIS_CA_12032019,BIS_CA_Amendment_Regulations_2020,listofproducts
