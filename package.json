{
  "name": "sih-bis-rag",
  "version": "2.0.0",
  "description": "Grounded RAG assistant for BIS standards: PDF ingestion -> Gemini embeddings -> pgvector -> cited answers",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ingest": "node scripts/ingest.js",
    "ingest:force": "node scripts/ingest.js --force",
    "ask": "node scripts/ask.js",
    "calibrate": "node scripts/calibrate.mjs",
    "test": "node --test \"test/chunker.test.js\" \"test/directory.test.js\" \"test/i18n.test.js\" \"test/ingest-preflight.test.js\" \"test/ingest-safety.test.js\" \"test/provider.test.js\" \"test/ollama.test.js\" \"test/title.test.js\"",
    "test:e2e": "node --experimental-test-module-mocks --test --test-concurrency=1 \"test/e2e-pipeline.test.js\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "keywords": [
    "rag",
    "bis",
    "pgvector",
    "gemini"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1"
  }
}
