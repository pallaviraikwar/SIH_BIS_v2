{
  "name": "sih-bis-rag",
  "version": "2.0.0",
  "description": "Grounded RAG assistant for BIS standards: PDF ingestion -> local Ollama embeddings -> pgvector -> cited answers",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ingest": "node scripts/ingest.js",
    "ingest:force": "node scripts/ingest.js --force",
    "index:export": "node scripts/export-index.js",
    "index:import": "node scripts/import-index.js",
    "ask": "node scripts/ask.js",
    "calibrate": "node scripts/calibrate.mjs",
    "setup:ollama": "./scripts/ollama-host-setup.sh",
    "test": "node --experimental-test-module-mocks --test \"test/chunker.test.js\" \"test/citations.test.js\" \"test/chat-route.test.js\" \"test/directory.test.js\" \"test/i18n.test.js\" \"test/index-snapshot.test.js\" \"test/ingest-preflight.test.js\" \"test/ingest-safety.test.js\" \"test/provider.test.js\" \"test/retrieval.test.js\" \"test/search.test.js\" \"test/ollama.test.js\" \"test/substance.test.js\" \"test/title.test.js\" \"test/translator.test.js\" \"test/ui-ux.test.js\"",
    "test:e2e": "node --experimental-test-module-mocks --test --test-concurrency=1 \"test/e2e-pipeline.test.js\"",
    "db:up": "docker compose up -d pgvector",
    "db:down": "docker compose stop pgvector",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f app",
    "docker:shell": "docker compose exec app sh",
    "docker:ingest": "docker compose run --rm --no-deps app npm run ingest",
    "docker:ingest:force": "docker compose run --rm --no-deps app npm run ingest:force",
    "docker:index:export": "docker compose run --rm --no-deps app npm run index:export",
    "docker:index:import": "docker compose run --rm --no-deps app npm run index:import --",
    "docker:test": "docker compose run --rm --no-deps app npm test",
    "docker:test:e2e": "docker compose run --rm --no-deps app npm run test:e2e",
    "docker:ask": "docker compose run --rm --no-deps app npm run ask --",
    "docker:reset": "docker compose down -v",
    "setup": "./run.sh"
  },
  "keywords": [
    "rag",
    "bis",
    "pgvector",
    "gemini"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1"
  }
}
